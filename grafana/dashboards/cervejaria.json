{
  "uid": "cervejaria",
  "title": "Cervejaria Byte: Monitoramento da Produção",
  "description": "Tanques de fermentação e linhas de envase de uma cervejaria fictícia.",
  "tags": [
    "cervejaria",
    "demo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "tanque",
        "label": "Tanque",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "cervejaria-pg"
        },
        "query": "SELECT codigo FROM tanques ORDER BY codigo",
        "definition": "SELECT codigo FROM tanques ORDER BY codigo",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Eventos da fábrica",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "cervejaria-pg"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.momento AS time,\n       e.descricao AS text,\n       e.tipo AS tags\nFROM eventos e\nWHERE $__timeFilter(e.momento)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Envasadas",
      "description": "Garrafas e latas aprovadas no período selecionado (canto superior direito).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sum(unidades_ok) AS \"Unidades\"\nFROM producao_envase\nWHERE $__timeFilter(momento)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Taxa de rejeição",
      "description": "Percentual de unidades descartadas no controle de qualidade.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * sum(unidades_rejeitadas)\n       / NULLIF(sum(unidades_ok + unidades_rejeitadas), 0) AS \"Rejeição\"\nFROM producao_envase\nWHERE $__timeFilter(momento)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tanques em alerta",
      "description": "Quantos tanques estão agora acima da temperatura máxima do seu estilo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Tanques\"\nFROM (\n    SELECT DISTINCT ON (tanque_id) tanque_id, temperatura_c\n    FROM leituras_tanque\n    ORDER BY tanque_id, momento DESC\n) ultima\nJOIN tanques t ON t.id = ultima.tanque_id\nWHERE ultima.temperatura_c > t.temp_max_c"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Refrigeração",
      "description": "Estado atual do sistema de refrigeração de cada tanque.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT codigo AS \"Tanque\",\n       CASE WHEN refrigeracao_ligada THEN 1 ELSE 0 END AS \"Refrigeração\"\nFROM tanques\nWHERE codigo IN ($tanque)\nORDER BY codigo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DESLIGADA",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Ligada",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Temperatura dos tanques",
      "description": "Temperatura de fermentação. As marcações verticais são eventos da fábrica (tabela eventos).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(l.momento, $__interval),\n       t.codigo || ' ' || t.estilo AS metric,\n       avg(l.temperatura_c) AS value\nFROM leituras_tanque l\nJOIN tanques t ON t.id = l.tanque_id\nWHERE $__timeFilter(l.momento)\n  AND t.codigo IN ($tanque)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Desvio da temperatura ideal",
      "description": "Quantos °C cada tanque está acima da temperatura ideal. Todo estilo tolera até +2 °C; acima disso o alerta dispara.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (t.codigo)\n       t.codigo AS \"Tanque\",\n       l.temperatura_c - t.temp_alvo_c AS \"Desvio\"\nFROM leituras_tanque l\nJOIN tanques t ON t.id = l.tanque_id\nWHERE t.codigo IN ($tanque)\nORDER BY t.codigo, l.momento DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "min": -1,
          "max": 5,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Produção por linha de envase",
      "description": "Unidades aprovadas em cada intervalo, empilhadas por linha.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(p.momento, $__interval),\n       li.codigo || ' ' || li.embalagem AS metric,\n       sum(p.unidades_ok) AS value\nFROM producao_envase p\nJOIN linhas_envase li ON li.id = p.linha_id\nWHERE $__timeFilter(p.momento)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pressão dos tanques",
      "description": "Pressão interna. Sobe junto com a temperatura porque a fermentação acelera e libera mais CO2.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(l.momento, $__interval),\n       t.codigo || ' ' || t.estilo AS metric,\n       avg(l.pressao_bar) AS value\nFROM leituras_tanque l\nJOIN tanques t ON t.id = l.tanque_id\nWHERE $__timeFilter(l.momento)\n  AND t.codigo IN ($tanque)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurebar",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Eventos da fábrica",
      "description": "Falhas e normalizações registradas (inclusive pelo refrigeracao.py).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cervejaria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cervejaria-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.momento   AS \"Quando\",\n       t.codigo    AS \"Tanque\",\n       e.tipo      AS \"Tipo\",\n       e.descricao AS \"Descrição\"\nFROM eventos e\nLEFT JOIN tanques t ON t.id = e.tanque_id\nORDER BY e.momento DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "falha": {
                        "text": "Falha",
                        "color": "red",
                        "index": 0
                      },
                      "normalizado": {
                        "text": "Normalizado",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quando"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tanque"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "alertlist",
      "title": "Alertas ativos",
      "description": "Regras de alerta do Grafana disparadas agora (grafana/provisioning/alerting/alertas.yml).",
      "gridPos": {
        "x": 14,
        "y": 24,
        "w": 10,
        "h": 8
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "showInstances": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        }
      }
    }
  ]
}
